{
  "name": "Devbox Fullstack Desktop",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "toolchain"
  },
  "remoteUser": "dev",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "noPassword",
      "webPort": "6080"
    }
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop (noVNC)",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "runArgs": ["--shm-size=1g"],
  "postCreateCommand": "/usr/local/bin/verify-toolchain"
}
